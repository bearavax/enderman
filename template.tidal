-}

-- SECTION 14: CUSTOM SYNTH DEFINITIONS
-- If you're using SuperDirt with custom synths, define them here

{-
-- Example custom synth definition (would go in your SuperDirt startup file)
(
SynthDef(\mySynth, {|out, freq=440, amp=0.5, pan=0, attack=0.01, release=1|
    var sig, env;
    env = EnvGen.kr(Env.perc(attack, release), doneAction: 2);
    sig = SinOsc.ar(freq) * env * amp;
    Out.ar(out, Pan2.ar(sig, pan));
}).add;
)

-- Using custom synth in TidalCycles
d8 $ n (scale "minor" "0 3 5 7") # s "mySynth" # gain 0.8 # attack 0.02 # release 0.5
-}

-- End of TidalCycles Template
do
    hush -- shift!
    -- resetCycles -- only first eval
    all $ id
    setbpm 125
    let note' n = note ((scale "minor" n))
    let kb = select "<0 1>/16" ["1","<1*4!12 1(3,8)!3 1(5,8)>"]
    let mixer = [ 1 -- kick
                , 1 -- snaredrum
                , 0 -- open hihat
                , 1 -- bass
                , 0 -- percs
                , 0 -- pad
                , 0 -- piano
                , 0 -- lead
                , 0 -- vox
                , 0 -- crash
                ]
    let chaos = 0 -- from 0 to 1
    let bside = 0 -- either 0 or 1
    let _swing = (swingBy (0/8) 4)
    let mix n = (|* gain (mixer !! n))
    d1 $ someCyclesBy chaos (shuffle "1_1 <1 8>") $ rot "<0!7 [0_1q 4]>" $ stack [
      mix 0 $ echo 2 (1/32) (chaos |* 0.8 |* irand 2) $ kb # s "909bd" |- note "[4,16~16~]" # shape 0.41
      ,mix 1 $ maymute 4 0.1 $ select bside [fast 2 "~1","~[~1]~1"] # s "ukgdksd"
      ,mix 2 $ degradeBy (chaos |/ 5) $ fast 4 "~909oh" # n "<1 2>/7" # gain 0.86
      ,mix 9 $ sound "808cr:1/8" |+ note 6 # gain 0.9
      ]
    d2 $ mix 3 $ kb # note' ("<0 [-1 [-2 -3]]>/4" |* (-bside)) |+ note 6.9 # s "savebs" # shape 0.73 # cut 1
    d3 $ mix 4 $ drumM "hl" [
        "items" |+ n "<0 30>/6" # release 0.1
        ,"~items:9" |+ n "<0 <0 9>/4>" |+ note rand # hpf 1000
        ,maymute 4 0.2 $ sometimesBy bside (mask "ftft") $ sometimesBy 0.2 (|- speed 2) "ui:2(<7 8>/4,16,<0 2>)" # pan (slow 6 sine)
        ,maymute 2 0.5 "~~roach:1/4"
        ,maymute 4 0.7 "buttons:1*2" # gain 0.8
      ] # lpf 15000 # gain 0.8 # delay (0.6 |* chaos) # delayt 0.13 # delayfb 0.3
    d4 $ mix 5
          $ (|- legato (chaos*rand|/8))
          $ sometimesBy "<0 [0.5]>" (|+ b' 11 (chaos*rand))
          $ sometimesBy bside (# b' 10 "<3!6 4!2>")
          $ "1*4" # b' 200 ("<17 35>" |+ "0_3 1" |+ "<0 30>/32") # s "hlprospero" # legato 1
          # gain 1.2 # lpf 14000
    d5 $ mix 6
          $ sometimesBy (chaos |/ 2) (|- speed "<1.5 2>")
          $ strat 16 2 "eternal2:1" |+ note "<6 -6>/32" # cut 1 # hpf 200
          |+ gain (slow 12 $ range 0.75 1 cosine) |* gain 1.333 # pan "[0 1]*4" # room 0.7
    d6 $ mix 7 $ someCyclesBy (1|-(chaos|/3)) (repeatCycles 4) $ struct "t(5,<8 16 8>,<0 2>/2)" $ note' (irand 5) # s "endorphin" # end 0.3 # speed 2 # lpf 5000
        # room 1 # size 0.92 # gain 0.8
    d7 $ mix 8 $ slow "<2 2 2 2 1>/4" $ repeatCycles 4 $ s "hlfvox" # n (irand 140) |+ n 2 # hpf 1200
        # wider 0.6 # gain 0.85
    all $ (|+ note "<0 4>/128") . _swing
    getnow 16
